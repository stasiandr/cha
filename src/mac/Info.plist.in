<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>${EXECUTABLE_NAME}</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>dev.stasiandr.cha</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${PRODUCT_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>${VERSION_SHORT}</string>
	<key>CFBundleShortVersionString</key>
	<string>${VERSION_SHORT}</string>
	<key>LSEnvironment</key>
	<dict>
		<key>MallocNanoZone</key>
		<string>0</string>
	</dict>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<!-- Pages ask for these through Chromium (passkeys from a phone use
	     Bluetooth, calls use the camera and microphone, maps the location).
	     Without a description macOS kills the app on first use. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>A website wants to use Bluetooth, for example to sign in with a passkey from your phone.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>A website wants to use Bluetooth, for example to sign in with a passkey from your phone.</string>
	<key>NSCameraUsageDescription</key>
	<string>A website wants to use your camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A website wants to use your microphone.</string>
	<key>NSLocationUsageDescription</key>
	<string>A website wants to know your location.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>A website wants to know your location.</string>
	<key>NSWebBrowserPublicKeyCredentialUsageDescription</key>
	<string>A website wants to sign you in with a passkey.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>A website wants to capture audio.</string>
	<key>NSPrincipalClass</key>
	<string>ChaApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
